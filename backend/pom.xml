<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.hardware</groupId>
    <artifactId>hardware-management-app</artifactId>
    <version>1.0.0</version>

    <!-- =========================================================
         JAVA CONFIGURATION
         ========================================================= -->
    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <!-- =========================================================
         DEPENDENCIES
         ========================================================= -->
    <dependencies>

        <!-- =====================================================
             MYSQL JDBC DRIVER
             Used for Java <-> MySQL database connection
             ===================================================== -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>9.4.0</version>
        </dependency>


        <!-- =====================================================
             APACHE PDFBOX
             Used for reading supplier PDF invoices
             ===================================================== -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>3.0.6</version>
        </dependency>


        <!-- =====================================================
             APACHE POI
             Used for Excel .xls files
             ===================================================== -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi</artifactId>
            <version>5.4.1</version>
        </dependency>


        <!-- =====================================================
             APACHE POI OOXML
             Used for Excel .xlsx files
             ===================================================== -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.4.1</version>
        </dependency>

    </dependencies>


    <!-- =========================================================
         BUILD CONFIGURATION
         ========================================================= -->
    <build>

        <plugins>

            <!-- =================================================
                 MAVEN COMPILER
                 Compiles project using Java 17
                 ================================================= -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.0</version>

                <configuration>
                    <source>17</source>
                    <target>17</target>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>


            <!-- =================================================
                 MAVEN EXEC
                 Runs Main.java using:
                 mvn exec:java
                 ================================================= -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>

                <configuration>
                    <mainClass>com.hardware.app.Main</mainClass>
                </configuration>
            </plugin>

        </plugins>

    </build>

</project>